# Django Settings
DJANGO_SECRET_KEY=django-insecure-avtohub-production-super-secret-key-change-in-prod-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database (PostgreSQL)
# If DB_ENGINE is empty or sqlite3, will use local SQLite for instant dev without setup
DB_ENGINE=sqlite3
DB_NAME=avtohub_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOW_ALL_ORIGINS=True

# OTP Settings
OTP_EXPIRY_SECONDS=180
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
MOCK_SMS_OTP=True
